{
  "name": "flowdown-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @a5omic/flowdown --workspace @a5omic/flowdown-react",
    "build:hosted": "npm run build && npm run build --workspace @a5omic/flowdown-hosted",
    "build:pages": "npm run build && node scripts/build-pages.mjs",
    "pretest": "npm run build",
    "test": "node --test test/**/*.test.js",
    "bench": "node test/bench/index.js",
    "demo": "npx serve demo"
  },
  "devDependencies": {
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.0.1",
    "markdown-it": "^14.1.1",
    "marked": "^17.0.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}

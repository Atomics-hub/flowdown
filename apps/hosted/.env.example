NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_CLOUD_RENDER_PRICE_ID=

# Optional: send magic links through Resend. If omitted in development,
# the login endpoint returns a local dev link.
RESEND_API_KEY=
LOGIN_FROM_EMAIL=Flowdown <login@example.com>

# Optional: dormant render API provisioning.
# Example:
# [{"name":"Acme","email":"buyer@example.com","apiKey":"fd_live_xxx","plan":"cloud"}]
FLOWDOWN_TENANTS_JSON=[]

# Optional: single shared render key for local testing only.
FLOWDOWN_RENDER_API_KEY=
